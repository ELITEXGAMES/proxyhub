# ==============================================================================
# Antigravity Proxy - Environment Configuration Template
# Copy this file to .env and configure as needed.
# CRITICAL: Never commit your real .env file or credentials to public Git repos!
# ==============================================================================

# Server Network Configuration
PORT=4000
HOST=0.0.0.0

# Optional: Restrict Dashboard Access with a Password (Recommended if hosted publicly)
# DASHBOARD_PASSWORD=your_secure_password_here

# Optional: Master API Key for clients (Alternative to dashboard-created keys)
# PROXY_API_KEY=agp-your_custom_proxy_key_here

# Rate Limiting (Requests Per Minute per IP, default: 180)
RATE_LIMIT_RPM=180

# Logging & Debugging
# Set to 'true' to log full request payloads in console (Warning: may log user prompts)
DEBUG_VERBOSE_LOGS=false

# Optional: Custom Data Storage Directory (default: ~/.antigravity-proxy)
# AG_DATA_DIR=/path/to/custom/data

# Optional: Background Daemon Log File
# AG_LOG_FILE=/path/to/proxy.log

# Google OAuth Client Credentials (Defaults to Antigravity public desktop client)
# ANTIGRAVITY_CLIENT_ID=your_custom_google_client_id.apps.googleusercontent.com
# ANTIGRAVITY_CLIENT_SECRET=your_custom_google_client_secret

# Optional: Google Cloud Storage for Video Hosting (if using custom GCS bucket)
# GCS_BUCKET=your_gcs_bucket_name
# GCS_PROJECT=your_gcs_project_id

